---
import SiteNav from '../components/SiteNav.svelte';
import CoreFullStack from '../components/Gap/CoreFullStack.svelte';
import Gap2CoreFullStack from '../components/Gap/Gap2CoreFullStack.svelte';
import Gap3CoreFullStack from '../components/Gap/Gap3CoreFullStack.svelte';
import '../styles/global.scss';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta
    name="description"
    content="Afzyl Azeez — Full-Stack Software Developer building secure, scalable, and user-focused web applications."
  />
  <meta name="theme-color" content="#E9E7DF" />
  <title>Afzyl Azeez — Full-Stack Software Developer</title>
</head>

<body>

  <!-- =====================================================
       THREE.JS PARTICLE EFFECT
       This stays BELOW portrait + icon waves.
       DO NOT MODIFY MainElement.js / Mouse.js.
       ===================================================== -->

  <div
    class="effect-layer"
    data-main-particles-component
    data-theme="dark"
    data-particles-scale="0.75"
    data-density="200"
    aria-hidden="true"
  >
    <div data-container></div>
  </div>

  <SiteNav client:load />

  <main id="top">

    <!-- ===================================================
         IMAGE 1 / HERO
         =================================================== -->

    <section class="image-section image-section-1" id="home">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG1.webp"
        alt=""
        fetchpriority="high"
      />

      <!-- PORTRAIT — TOP LAYER -->
      <img
        class="portrait"
        src="/Portraits/Portrait1.webp"
        alt="Portrait of Afzyl"
        fetchpriority="high"
      />

      <!-- HERO COPY CONTENT -->
      <div class="p1-copy" aria-label="Hero introduction">
        <p class="p1-greeting">Afzyl here!</p>
        <p class="p1-desc">Full-Stack Software Developer building secure, scalable, and user-focused web applications with clean interfaces and thoughtful digital experiences.</p>
      </div>

      <!-- BIG BOTTOM TEXT -->
      <p class="afzyl-big" aria-hidden="true">AFZYL</p>

      <!-- GAP 1 ICON WAVE — TOP LAYER -->
      <div class="icon-wave-layer">
        <CoreFullStack client:load />
      </div>

    </section>


    <!-- ===================================================
         IMAGE 2
         =================================================== -->

    <section class="image-section image-section-2" id="process">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG2.webp"
        alt=""
        loading="eager"
      />

      <!-- PAGE 2 — ORBITAL CONTENT OVERLAY -->
      <div class="p2-orbital" aria-label="Technology and philosophy">

        <!-- CENTER CORE -->
        <div class="p2-core">
          <span class="p2-core-name">AFZYL</span>
          <span class="p2-core-role">FULL-STACK<br/>DEVELOPER</span>
        </div>

        <!-- 3 MAIN CARDS -->
        <div class="p2-cards">
          <article class="p2-card">
            <span class="p2-card-num">01</span>
            <h2 class="p2-card-title">Full-Stack Engineering</h2>
            <p class="p2-card-desc">Building complete, production-ready applications from frontend to backend.</p>
          </article>
          <article class="p2-card p2-card--mid">
            <span class="p2-card-num">02</span>
            <h2 class="p2-card-title">Modern Digital Experiences</h2>
            <p class="p2-card-desc">Creating fast, interactive interfaces that combine clean engineering with thoughtful design.</p>
          </article>
          <article class="p2-card">
            <span class="p2-card-num">03</span>
            <h2 class="p2-card-title">Scalable &amp; Reliable</h2>
            <p class="p2-card-desc">Designing systems that are secure, maintainable, and ready to evolve with real-world needs.</p>
          </article>
        </div>

        <!-- 5 FLOATING NODES -->
        <ul class="p2-nodes" aria-label="Skill areas">
          <li class="p2-node p2-node--top">
            <span class="p2-node-label">ARCHITECTURE</span>
            <span class="p2-node-sub">System Design</span>
          </li>
          <li class="p2-node p2-node--left">
            <span class="p2-node-label">FRONTEND</span>
            <span class="p2-node-sub">React / UI</span>
          </li>
          <li class="p2-node p2-node--right">
            <span class="p2-node-label">BACKEND</span>
            <span class="p2-node-sub">Node / API</span>
          </li>
          <li class="p2-node p2-node--bl">
            <span class="p2-node-label">DATABASE</span>
            <span class="p2-node-sub">Data / Cloud</span>
          </li>
          <li class="p2-node p2-node--br">
            <span class="p2-node-label">ENGINEERING</span>
            <span class="p2-node-sub">DevOps / Tools</span>
          </li>
        </ul>

      </div>

      <!-- GAP 2 ICON WAVE — TOP LAYER -->
      <div class="icon-wave-layer">
        <Gap2CoreFullStack client:load />
      </div>

    </section>


    <!-- ===================================================
         IMAGE 3
         =================================================== -->

    <section class="image-section image-section-3" id="playground">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG3.webp"
        alt=""
        loading="lazy"
      />

      <!-- PAGE 3 — HOW I BUILD + PROJECTS -->
      <div class="p3-content" aria-label="How I build and selected work">

        <!-- INTRO -->
        <header class="p3-intro">
          <p class="p3-eyebrow">03 / HOW I BUILD</p>
          <h2 class="p3-heading">FROM IDEA<br/>TO PRODUCTION</h2>
          <p class="p3-intro-desc">I turn product ideas into structured, scalable web applications — combining thoughtful interface design, solid engineering, and production-focused development from the first architecture decision to deployment.</p>
        </header>

        <!-- DEVELOPMENT PROCESS -->
        <ol class="p3-stages" aria-label="Development process stages">
          <li class="p3-stage">
            <span class="p3-stage-num">01</span>
            <div class="p3-stage-body">
              <h3 class="p3-stage-title">DISCOVER<span class="p3-stage-sub">Understand the Problem</span></h3>
              <p class="p3-stage-desc">I start by understanding the product goal, users, requirements, and technical constraints before writing code.</p>
              <p class="p3-tags">Requirements · User Needs · Scope · Technical Constraints</p>
            </div>
          </li>
          <li class="p3-stage">
            <span class="p3-stage-num">02</span>
            <div class="p3-stage-body">
              <h3 class="p3-stage-title">ARCHITECT<span class="p3-stage-sub">Plan the System</span></h3>
              <p class="p3-stage-desc">I break the product into clear modules, data flows, APIs, components, and responsibilities before implementation begins.</p>
              <p class="p3-tags">Architecture · Data Flow · API Design · Database</p>
            </div>
          </li>
          <li class="p3-stage">
            <span class="p3-stage-num">03</span>
            <div class="p3-stage-body">
              <h3 class="p3-stage-title">ENGINEER<span class="p3-stage-sub">Build the Product</span></h3>
              <p class="p3-stage-desc">I develop the interface and backend as structured, reusable systems — connecting frontend interactions with reliable application logic and data.</p>
              <p class="p3-tags">Frontend · Backend · Components · APIs</p>
            </div>
          </li>
          <li class="p3-stage">
            <span class="p3-stage-num">04</span>
            <div class="p3-stage-body">
              <h3 class="p3-stage-title">REFINE<span class="p3-stage-sub">Make It Feel Right</span></h3>
              <p class="p3-stage-desc">I refine interactions, responsiveness, performance, accessibility, and visual details until the product feels cohesive across devices.</p>
              <p class="p3-tags">Responsive · Interaction · Performance · Accessibility</p>
            </div>
          </li>
          <li class="p3-stage">
            <span class="p3-stage-num">05</span>
            <div class="p3-stage-body">
              <h3 class="p3-stage-title">SHIP<span class="p3-stage-sub">Deploy &amp; Improve</span></h3>
              <p class="p3-stage-desc">I take completed applications into production, monitor real-world behavior, fix issues, and continuously improve the system.</p>
              <p class="p3-tags">Deployment · CI/CD · Monitoring · Iteration</p>
            </div>
          </li>
        </ol>

        <!-- BUILT WITH INTENT -->
        <section class="p3-intent" aria-labelledby="intent-heading">
          <h2 class="p3-intent-heading" id="intent-heading">BUILT WITH INTENT</h2>
          <p class="p3-intent-sub">Good software isn't only about making something work. It's about making it understandable, maintainable, secure, and ready for the next iteration.</p>
          <ul class="p3-pillars">
            <li><strong class="p3-pillar-title">MODULAR</strong><span class="p3-pillar-desc">Reusable components and clearly separated responsibilities.</span></li>
            <li><strong class="p3-pillar-title">SECURE</strong><span class="p3-pillar-desc">Authentication, authorization, validation, and role-aware application flows.</span></li>
            <li><strong class="p3-pillar-title">SCALABLE</strong><span class="p3-pillar-desc">Architecture designed to accommodate new features without unnecessary complexity.</span></li>
            <li><strong class="p3-pillar-title">PRODUCTION-MINDED</strong><span class="p3-pillar-desc">Performance, responsiveness, deployment, and real-world reliability considered from the beginning.</span></li>
          </ul>
        </section>

        <!-- SELECTED PRODUCTION WORK -->
        <section class="p3-projects" aria-labelledby="projects-heading">
          <h2 class="p3-projects-heading" id="projects-heading">Selected Production Work</h2>
          <div class="p3-project-grid">

            <article class="p3-project">
              <div class="p3-project-meta">
                <span class="p3-project-num">01</span>
                <span class="p3-project-cat">FULL-STACK / ENTERPRISE / RBAC</span>
              </div>
              <h3 class="p3-project-name">JailMeet</h3>
              <p class="p3-project-type">Enterprise Parole &amp; Visitor Management Platform</p>
              <p class="p3-project-highlight">4 ROLE-BASED MODULES — ADMIN · OFFICER · VISITOR · PRISONER</p>
              <p class="p3-project-desc">A secure role-based platform designed around complex institutional workflows, where functionality, authorization, and reliable data handling take priority alongside a polished user experience.</p>
              <p class="p3-project-focus">Role-based workflows · Authentication &amp; authorization · Complex modules · Database-driven · Responsive dashboards · Secure API · Production structure</p>
              <blockquote class="p3-project-quote">"Functionality first. Experience without sacrificing control."</blockquote>
            </article>

            <article class="p3-project">
              <div class="p3-project-meta">
                <span class="p3-project-num">02</span>
                <span class="p3-project-cat">FULL-STACK / PRODUCT UI / RESPONSIVE</span>
              </div>
              <h3 class="p3-project-name">Recipe.IO</h3>
              <p class="p3-project-type">Modern Recipe Sharing Platform</p>
              <p class="p3-project-desc">A modern recipe-sharing experience focused on making content discovery simple, visual, responsive, and enjoyable across devices.</p>
              <p class="p3-project-focus">Modern interface design · Responsive layouts · Content-focused UX · Reusable components · Smooth interactions · Clear hierarchy · Mobile-first</p>
              <blockquote class="p3-project-quote">"Turning structured content into an experience people want to explore."</blockquote>
            </article>

            <article class="p3-project">
              <div class="p3-project-meta">
                <span class="p3-project-num">03</span>
                <span class="p3-project-cat">GROUP PROJECT / AI / THREE.JS</span>
              </div>
              <h3 class="p3-project-name">Hue.AI</h3>
              <p class="p3-project-type">AI-Powered Creative Interface</p>
              <p class="p3-project-desc">A collaborative AI project where I focused on the interface architecture and interactive experience, connecting AI-generated results with a visually immersive frontend.</p>
              <p class="p3-project-focus">UI/UX architecture · Three.js integration · Interactive visual experiences · AI API integration · Frontend architecture · Collaborative development</p>
              <blockquote class="p3-project-quote">"Connecting AI intelligence with an expressive interactive interface."</blockquote>
            </article>

          </div>
          <p class="p3-closing">THREE PRODUCTS.<br/>THREE DIFFERENT PROBLEMS.<br/>ONE ENGINEERING APPROACH.</p>
        </section>

      </div>

      <!-- GAP 3 ICON WAVE — TOP LAYER -->
      <div class="icon-wave-layer">
        <Gap3CoreFullStack client:load />
      </div>

    </section>


    <!-- ===================================================
         IMAGE 4
         =================================================== -->

    <section class="image-section image-section-4 final-image-section" id="contact">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG4.webp"
        alt=""
        loading="lazy"
      />

      <!-- PAGE 4 — CONTACT CONTENT -->
      <div class="p4-contact" aria-label="Contact section">

        <p class="p4-eyebrow">04 / CONTACT</p>

        <p class="p4-avail"><span class="p4-dot" aria-hidden="true">●</span> AVAILABLE FOR OPPORTUNITIES</p>
        <p class="p4-avail-sub">Open to Full-Time Roles · Frontend · Full-Stack · Software Development</p>

        <h2 class="p4-heading">LET'S BUILD<br/>SOMETHING USEFUL.</h2>

        <p class="p4-body">I'm looking for my next opportunity where I can turn ideas into reliable, well-crafted digital products, solve meaningful problems, and continue growing as a software developer.</p>

        <!-- HIRE ME CTA — TODO_BLOCKER: replace href="#" with:
             mailto:YOUR_EMAIL?subject=Job%20Opportunity%20%E2%80%94%20Afzyl%20Azeez&body=Hi%20Afzyl%2C%0AI%20came%20across%20your%20portfolio%20and%20would%20like%20to%20discuss%20an%20opportunity.%0A%0ABest%20regards%2C
             when real email is provided -->
        <a
          class="p4-cta"
          id="hire-me-btn"
          href="#"
          aria-label="Hire Afzyl Azeez — opens email client"
        >HIRE ME ↗</a>

        <div class="p4-connect">
          <p class="p4-connect-label">CONNECT</p>
          <div class="p4-socials">
            <!-- TODO_BLOCKER: replace href="#" with real URLs when provided -->
            <a class="p4-social" href="#" id="social-whatsapp">WHATSAPP</a>
            <a class="p4-social p4-social--primary" href="#" id="social-linkedin">LINKEDIN</a>
            <a class="p4-social" href="#" id="social-instagram">INSTAGRAM</a>
            <a class="p4-social" href="#" id="social-x">X</a>
          </div>
        </div>

        <p class="p4-tagline">Have an opportunity, idea, or interesting problem to solve?<br/><strong>LET'S TALK.</strong></p>

        <div class="p4-sig">
          <p class="p4-sig-name">AFZYL AZEEZ</p>
          <p class="p4-sig-role">FULL-STACK SOFTWARE DEVELOPER</p>
        </div>

      </div>

      <!-- FOOTER -->
      <!-- TODO_BLOCKER: replace footer-name href="#" with real LinkedIn URL when provided -->
      <footer class="compact-footer">
        <p>© Designed &amp; developed by <a
          class="footer-name"
          href="#"
          id="footer-linkedin-link"
        >Afsal S Azeez</a>.</p>
      </footer>

    </section>

  </main>


  <!-- =====================================================
       GSAP + LENIS + THREE.JS INITIALIZATION
       ===================================================== -->

  <script>
    import '../effects/MainElement.js';
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (!reduce) {

      const lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      if (document.querySelector('.hero h1 span')) {

        gsap.from('.hero h1 span', {
          yPercent: 120,
          opacity: 0,
          duration: 1.35,
          stagger: 0.12,
          ease: 'power4.out'
        });

      }

      if (document.querySelector('.portrait')) {

        gsap.from('.portrait', {
          yPercent: 8,
          opacity: 0,
          scale: 0.97,
          duration: 1.6,
          delay: 0.2,
          ease: 'power3.out'
        });

      }

    }
  </script>

</body>
</html>


<style lang="scss">

/* =========================================================
   EXACT GLOBAL LAYER ORDER
   =========================================================

   0 = IMAGE
   10 = PARTICLES
   20 = PORTRAIT
   30 = ICON WAVES

   Therefore:

   TOP
   ─────────────────────────
   Portrait + Icon Waves
   ─────────────────────────
   Three.js particles
   ─────────────────────────
   Background image
   ─────────────────────────
   BOTTOM
   ========================================================= */


/* =========================================================
   IMAGE SECTIONS
   ========================================================= */

.image-section {
  position: relative;

  width: 100%;

  aspect-ratio: 2560 / 1600;

  /*
   * IMPORTANT:
   * Allows icon waves to cross the image boundary.
   */
  overflow: visible;

  background: #E9E7DF;

  /*
   * DO NOT use isolation here.
   * The particle layer must be able to sit
   * between the image and foreground elements.
   */

  isolation: auto;
}


/* =========================================================
   IMAGE BACKGROUND
   BOTTOM LAYER
   ========================================================= */

.hero-bg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: none;
  opacity: 1;

  z-index: 0;

  display: block;
}


/* =========================================================
   THREE.JS PARTICLE EFFECT
   MIDDLE LAYER
   ========================================================= */

.effect-layer {
  position: fixed;

  inset: 0;

  width: 100%;
  height: 100%;

  /*
   * ABOVE IMAGE
   * BELOW PORTRAIT
   * BELOW ICON WAVES
   */

  z-index: 10;

  pointer-events: none;
}

.effect-layer [data-container] {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;
}

.effect-layer canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;

  /*
   * Keep the canvas itself in the particle layer.
   */

  z-index: 0;
}


/* =========================================================
   PORTRAIT
   TOP LAYER
   ========================================================= */

.portrait {
  position: absolute;
  z-index: 25;

  left: clamp(18rem, 6vw, 10rem);
  bottom: 0;

  height: auto;
  width: min(32vw, 42rem);

  max-width: none;
  max-height: none;

  object-fit: contain;
  object-position: left bottom;
  transform: none;

  pointer-events: none;
}

/* =========================================================
   ICON WAVES
   TOPMOST LAYER
   ========================================================= */

.icon-wave-layer {
  position: absolute;

  left: 0;
  right: 0;

  bottom: 0;

  width: 100%;

  height: clamp(180px, 18vw, 350px);

  /*
   * Exactly half inside the current image
   * and half into the next image.
   *
   * This places the wave on the boundary.
   */

  transform: translateY(50%);

  /*
   * ABOVE EVERYTHING
   */

  z-index: 30;

  pointer-events: none;
}


/* =========================================================
   HERO TEXT
   ========================================================= */

.hero h1 {
  position: absolute;

  z-index: 21;

  inset: 22% var(--gutter) auto;

  margin: 0;

  display: flex;

  flex-direction: column;

  font:
    500
    clamp(5rem, 13.5vw, 13rem)
    / 0.76
    var(--sans);

  letter-spacing: -0.085em;

  text-transform: uppercase;
}

.hero h1 span {
  display: block;

  overflow: hidden;
}

.hero h1 .outline {
  align-self: flex-end;

  color: transparent;

  -webkit-text-stroke:
    1.5px
    rgba(241, 240, 235, 0.78);
}


/* =========================================================
   HERO INDEX
   ========================================================= */

.hero-index {
  position: absolute;

  z-index: 21;

  top: 15%;

  left: var(--gutter);
}


/* =========================================================
   HERO ROLE
   ========================================================= */

.hero-role {
  position: absolute;

  z-index: 21;

  right: var(--gutter);

  bottom: 5%;

  text-align: right;

  line-height: 1.8;
}


/* =========================================================
   HERO COPY
   ========================================================= */

.hero-copy {
  position: absolute;

  z-index: 21;

  left: var(--gutter);

  bottom: 5%;

  width: min(25rem, 42vw);

  display: flex;

  align-items: flex-end;

  gap: clamp(1.5rem, 4vw, 4rem);
}

.hero-copy > p {
  max-width: 17rem;

  margin: 0;

  font-size: clamp(0.8rem, 1vw, 0.95rem);

  line-height: 1.55;
}


/* =========================================================
   ROUND LINK
   ========================================================= */

.round-link {
  flex: 0 0 86px;

  aspect-ratio: 1;

  border:
    1px solid
    rgba(255, 255, 255, 0.45);

  border-radius: 50%;

  display: grid;

  place-content: center;

  gap: 0.4rem;

  text-align: center;

  font:
    0.58rem
    var(--mono);

  text-transform: uppercase;

  letter-spacing: 0.12em;

  transition:
    color 0.3s,
    background 0.3s,
    transform 0.3s;
}

.round-link:hover {
  color: var(--ink);

  background: #f1f0eb;

  transform: rotate(-8deg);
}

.round-link b {
  font:
    400
    1rem
    var(--sans);
}


/* =========================================================
   FOOTER — single-line signature
   ========================================================= */

.compact-footer {
  position: absolute;
  left: var(--gutter);
  right: var(--gutter);
  bottom: clamp(0.8rem, 2vw, 1.5rem);
  z-index: 21;
  margin: 0;
  padding: clamp(0.7rem, 1.2vw, 1rem) 0 0;
  border-top: 1px solid rgba(241, 240, 235, 0.3);
  color: rgba(241, 240, 235, 0.65);
  background: transparent;
  font: 400 0.82rem/1.5 var(--sans);
  letter-spacing: 0.02em;
  text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
}

.compact-footer p {
  margin: 0;
}

.footer-name {
  color: rgba(241, 240, 235, 0.9);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: transparent;
  transition: text-decoration-color 0.18s ease, opacity 0.18s ease;
  cursor: pointer;
}

.footer-name:hover {
  text-decoration-color: rgba(241, 240, 235, 0.7);
  opacity: 1;
}


/* =========================================================
   PAGE 1 — HERO COPY + BIG AFZYL TEXT
   ========================================================= */

.p1-copy {
  box-sizing: border-box;
  width: min(32rem, calc(100vw - (2 * var(--gutter))));
  max-width: calc(100vw - (2 * var(--gutter)));

  border: 1.3px solid rgba(2, 13, 25, 0.55);
  border-radius: 28px;
  padding: 1.5rem 1.8rem;

  position: absolute;
  z-index: 21;

  left: auto;
  right: 5vw;

  top: clamp(15rem, 18vh, 18rem);
  bottom: auto;

  width: min(28rem, 30vw);
  max-width: 30vw;

  display: flex;
  flex-direction: column;
  gap: 0.75rem;

  pointer-events: none;
}

.p1-greeting {
  margin: 0;
  font: 700 clamp(1.1rem, 2vw, 1.6rem)/1.2 var(--heading);
  color: #020D19;
  letter-spacing: -0.02em;
}

.p1-desc {
  margin: 0;
  font: 400 clamp(0.78rem, 1vw, 0.95rem)/1.6 var(--sans);
  color: #020D19;
  max-width: 22rem;
}

.afzyl-big {
  font-family: 'Rosnoc', sans-serif;
  font-weight: 400;
  font-size: clamp(9rem, 34vw, 34rem);
  line-height: 0.85;
  position: absolute;
  z-index: 20;
  bottom: 0.2em;
  left: 1.0rem;
  margin: 0;
  
