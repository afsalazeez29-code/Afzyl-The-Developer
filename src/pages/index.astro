    clamp(6rem, 14vw, 10rem);

  pointer-events: none;

  max-width: 700px;
}

.p4-eyebrow {
  margin: 0;

  font:
    500
    0.72rem/1
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.14em;

  color: rgba(241, 240, 235, 0.55);
}

.p4-avail {
  margin: 0;

  display: flex;

  align-items: center;

  gap: 0.5rem;

  font:
    600
    0.78rem/1
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.1em;

  color: rgba(241, 240, 235, 0.9);
}

.p4-dot {
  color: rgba(80, 200, 120, 0.9);

  font-size: 0.55em;
}

.p4-avail-sub {
  margin: 0;

  font:
    400
    0.72rem/1.4
    var(--sans);

  color: rgba(241, 240, 235, 0.55);

  letter-spacing: 0.04em;
}

.p4-heading {
  margin: 0.3rem 0 0;

  font:
    700
    clamp(2.2rem, 6vw, 5rem)/0.95
    var(--heading);

  letter-spacing: -0.03em;

  text-transform: uppercase;

  color: #f1f0eb;
}

.p4-body {
  margin: 0;

  font:
    400
    clamp(0.82rem, 1.1vw, 0.95rem)/1.65
    var(--sans);

  color: rgba(241, 240, 235, 0.75);

  max-width: 480px;
}

.p4-cta {
  display: inline-flex;

  align-items: center;

  gap: 0.4rem;

  align-self: flex-start;

  margin-top: 0.3rem;

  padding: 0.65rem 1.5rem;

  border:
    1px solid
    rgba(241, 240, 235, 0.6);

  border-radius: 999px;

  font:
    600
    0.8rem/1
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.1em;

  color: #f1f0eb;

  background: rgba(241, 240, 235, 0.06);

  pointer-events: all;

  transition:
    background 0.2s ease,
    border-color 0.2s ease;

  cursor: pointer;
}

.p4-cta:hover {
  background: rgba(241, 240, 235, 0.14);

  border-color: rgba(241, 240, 235, 0.9);
}

.p4-connect {
  margin-top: 0.5rem;
}

.p4-connect-label {
  margin: 0 0 0.5rem;

  font:
    500
    0.65rem/1
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.14em;

  color: rgba(241, 240, 235, 0.45);
}

.p4-socials {
  display: flex;

  flex-wrap: wrap;

  gap: 0.6rem 1.2rem;

  pointer-events: all;
}

.p4-social {
  font:
    500
    0.72rem/1
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.1em;

  color: rgba(241, 240, 235, 0.65);

  text-decoration: underline;

  text-underline-offset: 3px;

  text-decoration-color: transparent;

  transition:
    color 0.18s ease,
    text-decoration-color 0.18s ease;
}

.p4-social:hover {
  color: #f1f0eb;

  text-decoration-color:
    rgba(241, 240, 235, 0.6);
}

.p4-social--primary {
  color: rgba(241, 240, 235, 0.9);

  font-weight: 700;

  letter-spacing: 0.12em;
}

.p4-tagline {
  margin: 0.3rem 0 0;

  font:
    400
    clamp(0.78rem, 1vw, 0.88rem)/1.65
    var(--sans);

  color: rgba(241, 240, 235, 0.65);
}

.p4-tagline strong {
  font-weight: 700;

  color: #f1f0eb;

  display: block;

  margin-top: 0.2rem;
}

.p4-sig {
  margin-top: 0.8rem;

  padding-top: 0.8rem;

  border-top:
    1px solid
    rgba(241, 240, 235, 0.15);
}

.p4-sig-name {
  margin: 0 0 0.2rem;

  font:
    700
    clamp(0.82rem, 1.2vw, 1rem)/1
    var(--heading);

  letter-spacing: 0.06em;

  color: #f1f0eb;
}

.p4-sig-role {
  margin: 0;

  font:
    400
    0.68rem/1
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.1em;

  color: rgba(241, 240, 235, 0.5);
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (min-width: 1920px) {

  .portrait {
    width: min(42vw, 48rem);
  }

}


@media (max-width: 1200px) {

  .portrait {
    width: min(42vw, 31rem);

    max-width: 45%;
  }

}


@media (max-width: 900px) {

  .portrait {
    width: min(46vw, 24rem);

    max-width: 48%;
  }

}


@media (max-width: 720px) {

  .hero h1 {
    top: 26%;

    font-size: 20vw;
  }

  .hero h1 .outline {
    align-self: flex-start;
  }

  .portrait {
    left: var(--gutter);

    width: min(50vw, 19rem);

    max-width: 54%;

    max-height:
      calc(100svh - 72px);
  }

  .hero-copy {
    width: 65%;
  }

  .round-link {
    display: none;
  }

  .hero-role {
    display: none;
  }

  /* page 1 hero copy repositioned on mobile */
  .p1-copy {
    max-width: 90vw;

    bottom:
      clamp(4rem, 10vw, 7rem);
  }

  /* page 3 scrollable content pointer-events on mobile */
  .p3-content {
    pointer-events: auto;
  }

  /* page 4 full width on mobile */
  .p4-contact {
    max-width: 100%;
  }

}


@media (max-width: 480px) {

  .portrait {
    width: min(55vw, 15rem);

    max-width: 58%;
  }

}



/* =========================================================
   TASK 2 — PAGE 1: ABOUT CAROUSEL
   ========================================================= */

.p1-carousel {
  position: relative;
  min-height: 4rem;
}

.p1-slide {
  display: none;
  animation: p1-fadein 0.3s ease;
}

.p1-slide--active {
  display: block;
}

.p1-slide-num {
  margin: 0 0 0.35rem;
  font:
    600
    0.72rem/1
    var(--sans);
  color: rgba(2, 13, 25, 0.4);
  letter-spacing: 0.1em;
}

@keyframes p1-fadein {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.p1-carousel-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-top: 0.9rem;
  pointer-events: all;
}

/* HIRE ME BUTTON — vertical text-slide hover */
.p1-hire-btn {
  display: inline-flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
  /* Fix Safari border-radius clipping */
  -webkit-mask-image: -webkit-radial-gradient(white, black);
  height: 2rem;
  padding: 0 1rem;
  background: #020D19;
  color: #FAFAFA;
  border-radius: 999px;
  font:
    600
    0.75rem/1
    var(--sans);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  pointer-events: all;
  flex-shrink: 0;
}

.p1-hire-inner {
  display: flex;
  flex-direction: column;
  transition: transform 0.25 ease-in-out;
  pointer-events: none;
}

.p1-hire-text {
  display: block;
  line-height: 2rem;
  white-space: nowrap;
}

.p1-hire-btn:hover .p1-hire-inner {
  transform: translateY(-50%);
}

/* PREV/NEXT PILL */
.p1-nav-pill {
  display: flex;
  align-items: center;
  gap: 0;
  background: rgba(2, 13, 25, 0.07);
  border: 1px solid rgba(2, 13, 25, 0.18);
  border-radius: 999px;
  overflow: hidden;
  flex-shrink: 0;
}

.p1-nav-sep {
  display: block;
  width: 1px;
  height: 1rem;
  background: rgba(2, 13, 25, 0.18);
}

.p1-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.2rem;
  height: 2rem;
  background: transparent;
  border: none;
  cursor: pointer;
  color: #020D19;
  font-size: 1.2rem;
  line-height: 1;
  transition: background 0.18s ease;
  pointer-events: all;
}

.p1-nav-btn:hover {
  background: rgba(2, 13, 25, 0.1);
}

/* p1-copy pointer-events: controls need to be interactive */
.p1-copy {
  pointer-events: none;
}
.p1-carousel-controls {
  pointer-events: all;
}


/* =========================================================
   TASK 3B — PAGE 2: DEV-SPHERE LABEL
   ========================================================= */

.p2-devsphere-label {
  position: absolute;
  top: clamp(1.5rem, 3vw, 2.5rem);
  right: clamp(1.5rem, 4vw, 3.5rem);
  z-index: 25;
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: 10px;
  padding: 0.4rem 1rem;
  font:
    600
    clamp(0.75rem, 1vw, 0.9rem)/1
    var(--sans);
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.06em;
  pointer-events: none;
  user-select: none;
  backdrop-filter: blur(2px);
  white-space: nowrap;
}


/* =========================================================
   TASK 4 — PAGE 3: PROJECTS SECTION (NEW)
   ========================================================= */

.proj-header {
  max-width: 600px;
  margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
}

.proj-eyebrow {
  margin: 0 0 0.6rem;
  font:
    700
    clamp(1.1rem, 2.2vw, 1.8rem)/1
    var(--heading);
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: #f1f0eb;
}

.proj-intro {
  margin: 0;
  font:
    400
    clamp(0.8rem, 1.05vw, 0.93rem)/1.65
    var(--sans);
  color: rgba(241, 240, 235, 0.72);
  max-width: 480px;
}

/* PROJECT CARD */
.proj-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(1.5rem, 3vw, 2.5rem);
  align-items: start;
  padding: clamp(1.2rem, 2vw, 1.8rem);
  border: 1px solid rgba(241, 240, 235, 0.13);
  border-radius: 18px;
  background: rgba(2, 13, 25, 0.45);
  backdrop-filter: blur(6px);
  margin-bottom: clamp(1.2rem, 2vw, 1.8rem);
}

.proj-card:last-of-type {
  margin-bottom: 0;
}

.proj-img-wrap {
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 16 / 10;
  background: rgba(241, 240, 235, 0.05);
}

.proj-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.proj-card:hover .proj-img {
  transform: scale(1.03);
}

.proj-info {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.proj-num {
  font:
    600
    0.68rem/1
    var(--sans);
  color: rgba(241, 240, 235, 0.4);
  letter-spacing: 0.1em;
}

.proj-title {
  margin: 0;
  font:
    700
    clamp(1.3rem, 2.5vw, 2rem)/1
    var(--heading);
  letter-spacing: -0.02em;
  color: #f1f0eb;
}

.proj-stack {
  margin: 0;
  font:
    500
    0.7rem/1.4
    var(--sans);
  color: rgba(241, 240, 235, 0.5);
  letter-spacing: 0.03em;
}

.proj-desc {
  margin: 0;
  font:
    400
    clamp(0.78rem, 1vw, 0.9rem)/1.6
    var(--sans);
  color: rgba(241, 240, 235, 0.75);
}

/* PROJECT CTA — VERTICAL TEXT SLIDE HOVER */
.proj-cta {
  display: inline-flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
  -webkit-mask-image: -webkit-radial-gradient(white, black);
  height: 2.1rem;
  padding: 0 1.1rem;
  margin-top: 0.3rem;
  align-self: flex-start;
  border: 1px solid rgba(241, 240, 235, 0.35);
  border-radius: 999px;
  font:
    600
    0.75rem/1
    var(--sans);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #f1f0eb;
  text-decoration: none;
  background: rgba(241, 240, 235, 0.06);
  pointer-events: all;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.proj-cta:hover {
  border-color: rgba(241, 240, 235, 0.75);
  background: rgba(241, 240, 235, 0.12);
}

.proj-cta-inner {
  display: flex;
  flex-direction: column;
  transition: transform 0.55s ease-in-out;
  pointer-events: none;
}

.proj-cta-text {
  display: block;
  line-height: 2.1rem;
  white-space: nowrap;
}

.proj-cta:hover .proj-cta-inner {
  transform: translateY(-50%);
}

/* PROJECT FOOTER */
.proj-footer {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  margin-top: clamp(1.5rem, 2.5vw, 2rem);
  flex-wrap: wrap;
  pointer-events: all;
}

.proj-closing {
  margin: 0;
  font:
    400
    clamp(0.78rem, 1vw, 0.88rem)/1.5
    var(--sans);
  color: rgba(241, 240, 235, 0.6);
  font-style: italic;
}

/* PAGE 3 HIRE ME — VERTICAL TEXT SLIDE HOVER */
.proj-hire-btn {
  display: inline-flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
  -webkit-mask-image: -webkit-radial-gradient(white, black);
  height: 2.1rem;
  padding: 0 1.3rem;
  background: #020D19;
  color: #FAFAFA;
  border-radius: 999px;
  font:
    600
    0.75rem/1
    var(--sans);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s ease;
}

.proj-hire-btn:hover {
  opacity: 0.88;
}

.proj-hire-inner {
  display: flex;
  flex-direction: column;
  transition: transform  ease-in-out;
  pointer-events: none;
}

.proj-hire-text {
  display: block;
  line-height: 2.1rem;
  white-space: nowrap;
}

.proj-hire-btn:hover .proj-hire-inner {
  transform: translateY(-50%);
}

/* Page 3 pointer-events fix */
.proj-card,
.proj-cta,
.proj-hire-btn {
  pointer-events: all;
}


/* =========================================================
   TASK 5 — PAGE 4: GET IN TOUCH / CONTACT
   ========================================================= */

.p4-contact {
  position: absolute;
  z-index: 21;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding:
    clamp(2rem, 5vw, 4rem)
    var(--gutter);
  pointer-events: none;
}

.p4-touch-box {
  background: #020D19;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 24px;
  padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  max-width: 560px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
  pointer-events: all;
}

.p4-touch-heading {
  margin: 0;
  font:
    700
    clamp(1.8rem, 4vw, 3rem)/1
    var(--heading);
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: #f1f0eb;
}

.p4-touch-desc {
  margin: 0;
  font:
    400
    clamp(0.82rem, 1.05vw, 0.93rem)/1.65
    var(--sans);
  color: rgba(241, 240, 235, 0.72);
  max-width: 420px;
}

/* ICON ROW */
.p4-icons {
