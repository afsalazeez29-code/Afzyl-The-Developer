  position: absolute;

  z-index: 21;

  right: var(--gutter);

  bottom: 5%;

  text-align: right;

  line-height: 1.8;
}


/* =========================================================
   HERO COPY
   ========================================================= */

.hero-copy {
  position: absolute;

  z-index: 21;

  left: var(--gutter);

  bottom: 5%;

  width: min(25rem, 42vw);

  display: flex;

  align-items: flex-end;

  gap: clamp(1.5rem, 4vw, 4rem);
}

.hero-copy > p {
  max-width: 17rem;

  margin: 0;

  font-size: clamp(0.8rem, 1vw, 0.95rem);

  line-height: 1.55;
}


/* =========================================================
   ROUND LINK
   ========================================================= */

.round-link {
  flex: 0 0 86px;

  aspect-ratio: 1;

  border:
    1px solid
    rgba(255, 255, 255, 0.45);

  border-radius: 50%;

  display: grid;

  place-content: center;

  gap: 0.4rem;

  text-align: center;

  font:
    0.58rem
    var(--mono);

  text-transform: uppercase;

  letter-spacing: 0.12em;

