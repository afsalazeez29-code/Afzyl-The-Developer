  <!-- =====================================================
       GSAP + LENIS + THREE.JS INITIALIZATION
       ===================================================== -->

  <script>
    import '../effects/MainElement.js';
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (!reduce) {

      const lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      if (document.querySelector('.hero h1 span')) {

        gsap.from('.hero h1 span', {
          yPercent: 120,
          opacity: 0,
          duration: 1.35,
          stagger: 0.12,
          ease: 'power4.out'
        });

      }

      if (document.querySelector('.portrait')) {

        gsap.from('.portrait', {
          yPercent: 8,
          opacity: 0,
          scale: 0.97,
          duration: 1.6,
          delay: 0.2,
          ease: 'power3.out'
        });

      }

      // Page 1 Carousel Logic
      const p1Slides = document.querySelectorAll('.p1-slide');
      const p1Prev = document.getElementById('p1-prev');
      const p1Next = document.getElementById('p1-next');
      let p1CurrentIndex = 0;

      if (p1Slides.length > 0 && p1Prev && p1Next) {
        function showSlide(index: number) {
          p1Slides.forEach((slide, i) => {
            if (i === index) {
              slide.classList.add('p1-slide--active');
            } else {
              slide.classList.remove('p1-slide--active');
            }
          });
        }
        
        p1Prev.addEventListener('click', () => {
          p1CurrentIndex = (p1CurrentIndex - 1 + p1Slides.length) % p1Slides.length;
          showSlide(p1CurrentIndex);
        });

        p1Next.addEventListener('click', () => {
          p1CurrentIndex = (p1CurrentIndex + 1) % p1Slides.length;
          showSlide(p1CurrentIndex);
        });
      }

    }
  </script>

</body>
</html>


<style lang="scss">

/* =========================================================
   IMAGE SECTIONS
   ========================================================= */

.image-section {
  position: relative;

  width: 100%;

  aspect-ratio: 2560 / 1600;

  overflow: visible;

  background: #E9E7DF;

  /*
   * DO NOT use isolation here.
   * The particle layer must be able to sit
   * between the image and foreground elements.
   */

  isolation: auto;
}


/* =========================================================
   IMAGE BACKGROUND
   BOTTOM LAYER
   ========================================================= */

.hero-bg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: none;
  opacity: 1;

  z-index: 0;

  display: block;
}


/* =========================================================
   THREE.JS PARTICLE EFFECT
   ========================================================= */

.effect-layer {
  display: none !important;

  position: fixed;

  inset: 0;

  width: 100%;
  height: 100%;

  z-index: 10;

  pointer-events: none;
}

.effect-layer [data-container] {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;
}

.effect-layer canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;

  z-index: 0;
}


/* =========================================================
   PORTRAIT
   ========================================================= */

.portrait {
  position: absolute;

  z-index: 25;

  left: clamp(18rem, 6vw, 10rem);
  bottom: 0;

  height: auto;
  width: min(32vw, 42rem);

  max-width: none;
  max-height: none;

  object-fit: contain;
  object-position: left bottom;

  transform: none;

  pointer-events: none;
}


/* =========================================================
   HERO TEXT
   ========================================================= */

.hero h1 {
  position: absolute;

  z-index: 21;

  inset: 22% var(--gutter) auto;

  margin: 0;

  display: flex;

  flex-direction: column;

  font:
    500
    clamp(5rem, 13.5vw, 13rem)
    / 0.76
    var(--sans);

  letter-spacing: -0.085em;

  text-transform: uppercase;
}

.hero h1 span {
  display: block;

  overflow: hidden;
}

.hero h1 .outline {
  align-self: flex-end;

  color: transparent;

  -webkit-text-stroke:
    1.5px
