/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (min-width: 1920px) {

  .portrait {
    width: min(42vw, 48rem);
  }

}


@media (max-width: 1200px) {

  .portrait {
    width: min(42vw, 31rem);

    max-width: 45%;
  }

}


@media (max-width: 900px) {

  .portrait {
    width: min(46vw, 24rem);

    max-width: 48%;
  }

}


@media (max-width: 720px) {

  .hero h1 {
    top: 26%;

    font-size: 20vw;
  }

  .hero h1 .outline {
    align-self: flex-start;
  }

  .portrait {
    left: var(--gutter);

    width: min(50vw, 19rem);

    max-width: 54%;

    max-height:
      calc(100svh - 72px);
  }

  .hero-copy {
    width: 65%;
  }

  .round-link {
    display: none;
  }

  .hero-role {
    display: none;
  }

  /* page 1 hero copy repositioned on mobile */
  .p1-copy {
    max-width: 90vw;

    bottom:
      clamp(4rem, 10vw, 7rem);
  }

  /* page 3 scrollable content pointer-events on mobile */
  .p3-content {
    pointer-events: auto;
  }

  /* page 4 full width on mobile */
  .p4-contact {
    max-width: 100%;
  }

}


@media (max-width: 480px) {

  .portrait {
    width: min(55vw, 15rem);

    max-width: 58%;
  }

}

/* =========================================================
   TASK 2 — PAGE 1: ABOUT CAROUSEL
   ========================================================= */

.p1-carousel {
  position: relative;
  min-height: 4rem;
}

.p1-slide {
  display: none;
  animation: p1-fadein 0.3s ease;
}

.p1-slide--active {
  display: block;
}

@keyframes p1-fadein {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.p1-carousel-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-top: 0.9rem;
  pointer-events: all;
}

/* HIRE ME BUTTON — vertical text-slide hover */
/* HIRE ME BUTTON — vertical text-slide hover */
.p1-hire-btn {
  display: inline-flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;

  /* Fix Safari border-radius clipping */
  -webkit-mask-image: -webkit-radial-gradient(white, black);

  height: 2.2rem;
  padding: 0 1.4rem;

  /* Gradient border */
  border: 2px solid transparent;

  border-radius: 999px;

  background:
    linear-gradient(#FAFAFA, #FAFAFA) padding-box,
    linear-gradient(to right, #FAFAFA, #E12E0F) border-box;

  color: #020D19;

  font:
    600
    0.85rem/1
    var(--sans);

  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;

  cursor: pointer;
  pointer-events: all;
  flex-shrink: 0;

  transform: translateY(0.8rem);
}

.p1-hire-inner {
  display: flex;
  flex-direction: column;
  transition: transform 0.45s ease-in-out;
  pointer-events: none;
}

.p1-hire-text {
  display: block;
  line-height: 2rem;
  white-space: nowrap;
}

.p1-hire-btn:hover .p1-hire-inner {
  transform: translateY(-50%);
}

/* PREV/NEXT PILL */
.p1-nav-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap:0;
  background: transparent;
  border-radius: 999px;
  overflow: hidden;
  flex-shrink: 0;
}

.p1-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  background: transparent;
  border: none;
  cursor: pointer;
  color: #FAFAFA;
  font-size: 2.2rem;
  line-height: 1;
  transition: background 0.18s ease;
  pointer-events: all;
}

.p1-nav-btn:hover {
  background: rgba(2, 13, 25, 0.1);
}

/* p1-copy pointer-events: controls need to be interactive */
.p1-copy {
  pointer-events: none;
}
.p1-carousel-controls {
  pointer-events: all;
}


