---
import SiteNav from '../components/SiteNav.svelte';
import '../styles/global.scss';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Afzyl — creative developer crafting cinematic digital experiences." />
  <meta name="theme-color" content="#0a0a0a" />
  <title>Afzyl — Creative Developer</title>
</head>
<body>
  <SiteNav client:load />
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-bg" src="/images/hero-bg.webp" alt="" fetchpriority="high" />
      <div class="hero-wash"></div>
      <p class="hero-index eyebrow">Portfolio / 2026</p>
      <h1 id="hero-title"><span>Creative</span><span class="outline">Developer</span></h1>
      <img class="portrait" src="/images/portrait.webp" alt="Portrait of Afzyl" fetchpriority="high" />
      <div class="hero-copy">
        <p>I shape expressive digital experiences where design, motion and technology move as one.</p>
        <a class="round-link" href="#work" aria-label="Explore selected work"><span>Explore</span><b>↓</b></a>
      </div>
      <p class="hero-role eyebrow">Designer × Developer<br />Based in India</p>
    </section>

    <section class="statement" id="about" aria-labelledby="statement-title">
      <div class="statement-meta"><p class="eyebrow">01 / Philosophy</p><p class="eyebrow">Independent creative practice</p></div>
      <h2 id="statement-title">I build digital work with <em>clarity, character</em> and a reason to be remembered.</h2>
      <div class="statement-foot"><p>Thoughtful identities. Immersive interfaces. Precise code.</p><p>Scroll to view selected work</p></div>
    </section>

    <section class="work" id="work" aria-labelledby="work-title">
      <div class="section-head"><p class="eyebrow">02 / Selected work</p><h2 id="work-title">A few things<br />made with intent.</h2><p class="count">(03)</p></div>
      <article class="project project-featured">
        <a class="project-image" href="#contact" aria-label="View RSP project">
          <img src="/images/rsp-ui.png" alt="RSP digital product interface" loading="lazy" />
          <span class="view">View case study ↗</span>
        </a>
        <div class="project-info"><p class="eyebrow">01 — Product / Development</p><h3>RSP Platform</h3><p>A focused digital system built to turn complex operations into a calm, coherent experience.</p><span>2026</span></div>
      </article>
      <article class="project project-split">
        <a class="project-image blueprint" href="#contact" aria-label="View Blueprint project"><img src="/images/blueprint.jpeg" alt="Architectural blueprint study" loading="lazy" /><span class="view">View study ↗</span></a>
        <div class="project-info"><p class="eyebrow">02 — Experiment / Direction</p><h3>Blueprint</h3><p>An editorial investigation of structure, proportion and systems that stay out of the way.</p><span>2025</span></div>
      </article>
      <article class="project project-type">
        <div class="type-canvas"><span>AF</span><i>Form follows feeling.</i></div>
        <div class="project-info"><p class="eyebrow">03 — Identity / Digital</p><h3>Personal Index</h3><p>A living identity built from stark contrasts, generous space and typography in motion.</p><span>Ongoing</span></div>
      </article>
    </section>

    <section class="services" aria-labelledby="services-title">
      <p class="eyebrow">03 / Capabilities</p>
      <h2 id="services-title">From first thought<br />to final frame.</h2>
      <ol>
        <li><span>01</span><h3>Creative Direction</h3><p>Positioning, visual systems, art direction</p></li>
        <li><span>02</span><h3>Experience Design</h3><p>UX strategy, UI design, prototyping</p></li>
        <li><span>03</span><h3>Creative Development</h3><p>Astro, Svelte, motion, interactive systems</p></li>
      </ol>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">04 / Start a conversation</p>
      <h2 id="contact-title">Have something<br /><em>worth making?</em></h2>
      <a class="contact-link" href="mailto:hello@afzyl.dev">hello@afzyl.dev <span>↗</span></a>
      <footer><p>© 2026 AFZYL</p><p>India · <span id="clock">IST</span></p><div><a href="#">LinkedIn</a><a href="#">GitHub</a><a href="#top">Back to top ↑</a></div></footer>
    </section>
  </main>

  <script>
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
      gsap.from('.hero h1 span', { yPercent: 120, opacity: 0, duration: 1.35, stagger: .12, ease: 'power4.out' });
      gsap.from('.portrait', { yPercent: 8, opacity: 0, scale: .97, duration: 1.6, delay: .2, ease: 'power3.out' });
      gsap.to('.portrait', { yPercent: 10, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true } });
      gsap.utils.toArray<HTMLElement>('.statement h2, .section-head h2, .services h2').forEach((el) => gsap.from(el, { y: 70, opacity: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 85%' } }));
      gsap.utils.toArray<HTMLElement>('.project').forEach((el) => gsap.from(el, { y: 80, opacity: 0, duration: 1.1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 82%' } }));
    }
    const clock = document.querySelector('#clock');
    const updateClock = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date()) + ' IST'; };
    updateClock(); setInterval(updateClock, 60000);
  </script>
</body>
</html>

<style lang="scss">
  .hero { position: relative; min-height: 100svh; overflow: hidden; color: #f1f0eb; background: #090909; isolation: isolate; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); opacity: .5; z-index: -3; }
  .hero-wash { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgba(0,0,0,.62), rgba(0,0,0,.06) 54%, rgba(0,0,0,.45)), linear-gradient(0deg, rgba(0,0,0,.6), transparent 45%); }
  .portrait { position: absolute; z-index: -1; left: 50%; bottom: -1%; height: 91%; max-width: none; transform: translateX(-50%); object-fit: contain; object-position: bottom; filter: grayscale(1) contrast(1.06); }
  .hero h1 { position: absolute; inset: 22% var(--gutter) auto; margin: 0; display: flex; flex-direction: column; font: 500 clamp(5rem, 13.5vw, 13rem)/.76 var(--sans); letter-spacing: -.085em; text-transform: uppercase; }
  .hero h1 span { display: block; overflow: hidden; }
  .hero h1 .outline { align-self: flex-end; color: transparent; -webkit-text-stroke: 1.5px rgba(241,240,235,.78); }
  .hero-index { position: absolute; top: 15%; left: var(--gutter); }
  .hero-role { position: absolute; right: var(--gutter); bottom: 5%; text-align: right; line-height: 1.8; }
  .hero-copy { position: absolute; left: var(--gutter); bottom: 5%; width: min(25rem, 42vw); display: flex; align-items: flex-end; gap: clamp(1.5rem, 4vw, 4rem); }
  .hero-copy > p { max-width: 17rem; margin: 0; font-size: clamp(.8rem, 1vw, .95rem); line-height: 1.55; }
  .round-link { flex: 0 0 86px; aspect-ratio: 1; border: 1px solid rgba(255,255,255,.45); border-radius: 50%; display: grid; place-content: center; gap: .4rem; text-align: center; font: .58rem var(--mono); text-transform: uppercase; letter-spacing: .12em; transition: color .3s, background .3s, transform .3s; }
  .round-link:hover { color: var(--ink); background: #f1f0eb; transform: rotate(-8deg); }
  .round-link b { font: 400 1rem var(--sans); }
  .statement { min-height: 100svh; padding: clamp(7rem, 13vw, 13rem) var(--gutter) 4rem; display: flex; flex-direction: column; justify-content: space-between; }
  .statement-meta, .statement-foot { display: flex; justify-content: space-between; align-items: flex-end; }
  .statement h2 { width: min(1100px, 92%); margin: 15vh auto; font: 500 clamp(3rem, 7.2vw, 7.2rem)/1.01 var(--sans); letter-spacing: -.06em; }
  .statement h2 em { font-family: var(--serif); font-weight: 500; }
  .statement-foot { padding-top: 1.5rem; border-top: 1px solid var(--line); font: .7rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .work { padding: clamp(7rem, 12vw, 12rem) var(--gutter); background: var(--ink); color: var(--paper); }
  .section-head { display: grid; grid-template-columns: 1fr 2fr auto; align-items: start; margin-bottom: 10vw; }
  .section-head h2 { margin: -.2em 0 0; font: 500 clamp(3rem, 6vw, 6rem)/.98 var(--sans); letter-spacing: -.06em; }
  .count { margin: 0; font: .8rem var(--mono); }
  .project { display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(260px, .9fr); gap: clamp(2rem, 5vw, 6rem); align-items: end; padding-bottom: clamp(7rem, 14vw, 13rem); }
  .project-image { position: relative; overflow: hidden; background: #1a1a1a; aspect-ratio: 16/10; }
  .project-image img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: transform .8s cubic-bezier(.2,.7,.2,1), filter .4s; }
  .project-image:hover img { transform: scale(1.025); filter: grayscale(.25); }
  .view { position: absolute; right: 1rem; bottom: 1rem; padding: .7rem 1rem; color: var(--ink); background: var(--paper); font: .6rem var(--mono); text-transform: uppercase; letter-spacing: .08em; transform: translateY(150%); transition: transform .4s; }
  .project-image:hover .view { transform: none; }
  .project-info { display: grid; gap: 1rem; padding-bottom: .5rem; }
  .project-info h3 { margin: 1rem 0 0; font: 500 clamp(2rem, 4vw, 4rem)/1 var(--sans); letter-spacing: -.05em; }
  .project-info > p:not(.eyebrow) { margin: 0; max-width: 24rem; color: var(--muted); font-size: .85rem; line-height: 1.65; }
  .project-info > span { margin-top: 1.5rem; font: .65rem var(--mono); }
  .project-split { grid-template-columns: minmax(240px,.85fr) minmax(0,1.3fr); width: 82%; margin-left: auto; }
  .project-split .project-info { grid-row: 1; grid-column: 1; }
  .blueprint { grid-column: 2; aspect-ratio: 4/5; }
  .type-canvas { aspect-ratio: 16/9; background: #e6e3da; color: #0a0a0a; overflow: hidden; display: grid; place-items: center; position: relative; }
  .type-canvas span { font: 600 min(31vw, 28rem)/.7 var(--sans); letter-spacing: -.16em; transform: translateX(-.07em); }
  .type-canvas i { position: absolute; font: 500 clamp(1rem, 2vw, 2rem) var(--serif); }
  .services { padding: clamp(7rem, 12vw, 12rem) var(--gutter); }
  .services > h2 { margin: 8vw 0; font: 500 clamp(3.5rem, 8vw, 8rem)/.9 var(--sans); letter-spacing: -.07em; }
  .services ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .services li { display: grid; grid-template-columns: .35fr 1.3fr 1fr; gap: 2rem; align-items: center; padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .services li > span { font: .65rem var(--mono); }
  .services h3 { margin: 0; font-size: clamp(1.4rem, 2.5vw, 2.5rem); letter-spacing: -.04em; }
  .services li p { margin: 0; color: #666; font: .72rem/1.6 var(--mono); }
  .contact { min-height: 90svh; padding: clamp(7rem, 10vw, 10rem) var(--gutter) 2rem; color: var(--paper); background: var(--ink); display: flex; flex-direction: column; }
  .contact h2 { margin: auto 0 5vw; font: 500 clamp(4rem, 11vw, 11rem)/.79 var(--sans); letter-spacing: -.08em; }
  .contact h2 em { font-family: var(--serif); font-weight: 500; }
  .contact-link { border-bottom: 1px solid #555; padding: 1.5rem 0; display: flex; justify-content: space-between; font: 400 clamp(1.2rem, 2.2vw, 2.2rem) var(--mono); }
  footer { margin-top: 7vw; padding-top: 1.5rem; border-top: 1px solid #333; display: grid; grid-template-columns: 1fr 1fr 1fr; font: .6rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  footer > p:nth-child(2) { text-align: center; }
  footer div { display: flex; justify-content: flex-end; gap: 1.5rem; }
  @media (max-width: 720px) {
    .hero h1 { top: 26%; font-size: 20vw; }
    .hero h1 .outline { align-self: flex-start; }
    .portrait { left: 58%; height: 78%; }
    .hero-copy { width: 65%; }
    .round-link { display: none; }
    .hero-role { display: none; }
    .statement h2 { width: 100%; margin: 10vh 0; }
    .statement-meta > p:last-child, .statement-foot > p:last-child { display: none; }
    .section-head { grid-template-columns: 1fr auto; gap: 2rem; }
    .section-head h2 { grid-row: 2; grid-column: 1 / -1; }
    .project, .project-split { width: 100%; grid-template-columns: 1fr; gap: 1.5rem; margin: 0; }
    .project-split .project-info, .blueprint { grid-row: auto; grid-column: auto; }
    .blueprint { aspect-ratio: 4/5; }
    .services li { grid-template-columns: auto 1fr; }
    .services li p { grid-column: 2; }
    footer { grid-template-columns: 1fr auto; gap: 1rem; }
    footer > p:nth-child(2) { text-align: right; }
    footer div { grid-column: 1 / -1; justify-content: flex-start; }
  }
</style>
