<!-- =====================================================
       GSAP + LENIS + THREE.JS INITIALIZATION
       ===================================================== -->

  <script>
    import '../effects/MainElement.js';
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (!reduce) {

      const lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      if (document.querySelector('.hero h1 span')) {

        gsap.from('.hero h1 span', {
          yPercent: 120,
          opacity: 0,
          duration: 1.35,
          stagger: 0.12,
          ease: 'power4.out'
        });

      }

      if (document.querySelector('.portrait')) {

        gsap.from('.portrait', {
          yPercent: 8,
          opacity: 0,
          scale: 0.97,
          duration: 1.6,
          delay: 0.2,
          ease: 'power3.out'
        });

      }

      // Page 1 Carousel Logic
      const p1Slides = document.querySelectorAll('.p1-slide');
      const p1Prev = document.getElementById('p1-prev');
      const p1Next = document.getElementById('p1-next');
      let p1CurrentIndex = 0;

      if (p1Slides.length > 0 && p1Prev && p1Next) {
        function showSlide(index: number) {
          p1Slides.forEach((slide, i) => {
            if (i === index) {
              slide.classList.add('p1-slide--active');
            } else {
              slide.classList.remove('p1-slide--active');
            }
          });
        }
        
        p1Prev.addEventListener('click', () => {
          p1CurrentIndex = (p1CurrentIndex - 1 + p1Slides.length) % p1Slides.length;
          showSlide(p1CurrentIndex);
        });

        p1Next.addEventListener('click', () => {
          p1CurrentIndex = (p1CurrentIndex + 1) % p1Slides.length;
          showSlide(p1CurrentIndex);
        });
      }

      // =====================================================
      // PAGE 3 — LAYERED GSAP IMAGE CAROUSEL
      // Independent per project. Touch + click controlled.
      // =====================================================
      (function () {
        const DURATION = 0.72;
        const EASE_IN  = 'power2.in';
        const EASE_OUT = 'power2.out';
        const EASE_IO  = 'power2.inOut';

        // Scale / brightness for back layers
        const BACK_SCALE      = 0.93;
        const BACK_BRIGHTNESS = 0.45;
        const BACK_OPACITY    = 0.75;

        function initCarousel(wrapper: HTMLElement) {
          const stage   = wrapper.querySelector<HTMLElement>('.proj-carousel-stage');
          const slides  = Array.from(wrapper.querySelectorAll<HTMLElement>('.proj-carousel-slide'));
          const prevBtn = wrapper.querySelector<HTMLButtonElement>('.proj-carousel-prev');
          const nextBtn = wrapper.querySelector<HTMLButtonElement>('.proj-carousel-next');

          if (!stage || slides.length === 0 || !prevBtn || !nextBtn) return;

          let current  = 0;
          let animating = false;

          // ---- initial state ----
          slides.forEach((slide, i) => {
            if (i === 0) {
              // active: front
              gsap.set(slide, {
                x: 0,
                scale: 1,
                opacity: 1,
                filter: 'brightness(1)',
                zIndex: 2,
                position: 'absolute',
                inset: 0,
              });
            } else {
              // back layers: offset slightly to hint depth
              gsap.set(slide, {
                x: '100%',
                scale: BACK_SCALE,
                opacity: BACK_OPACITY,
                filter: `brightness(${BACK_BRIGHTNESS})`,
                zIndex: 1,
                position: 'absolute',
                inset: 0,
              });
            }
          });

          updateButtons();

          // ---- transition ----
          function goTo(next: number, dir: 1 | -1) {
            if (animating || next === current) return;
            animating = true;

            const outSlide = slides[current];
            const inSlide  = slides[next];
            const xFrom    = dir === 1 ? '100%' : '-100%';
            const xTo      = dir === 1 ? '-30%' : '30%';

            // Prepare incoming: position off-screen on the correct side
            gsap.set(inSlide, {
              x: xFrom,
              scale: BACK_SCALE,
              opacity: BACK_OPACITY,
              filter: `brightness(${BACK_BRIGHTNESS})`,
              zIndex: 3,   // above outgoing during transit
            });

            const tl = gsap.timeline({
              onComplete: () => {
                // Finalize
                gsap.set(inSlide, { zIndex: 2 });
                gsap.set(outSlide, { zIndex: 1 });
                current   = next;
                animating = false;
                updateButtons();
              }
            });

            // Outgoing: slide away & shrink
            tl.to(outSlide, {
              x: xTo,
              scale: BACK_SCALE,
              opacity: BACK_OPACITY,
              filter: `brightness(${BACK_BRIGHTNESS})`,
              duration: DURATION,
              ease: EASE_IO,
            }, 0);

            // Incoming: arrive & grow into foreground
            tl.to(inSlide, {
              x: 0,
              scale: 1,
              opacity: 1,
              filter: 'brightness(1)',
              duration: DURATION,
              ease: EASE_IO,
            }, 0);
          }

          function updateButtons() {
            if (!prevBtn || !nextBtn) return;
            prevBtn.disabled = current === 0;
            nextBtn.disabled = current === slides.length - 1;
          }

          // ---- click ----
          prevBtn.addEventListener('click', () => {
            if (current > 0) goTo(current - 1, -1);
          });
          nextBtn.addEventListener('click', () => {
            if (current < slides.length - 1) goTo(current + 1, 1);
          });

          // ---- touch / swipe ----
          let touchStartX = 0;
          let touchStartY = 0;
          let touchActive = false;

          stage.addEventListener('touchstart', (e: TouchEvent) => {
            const t = e.touches[0];
            touchStartX = t.clientX;
            touchStartY = t.clientY;
            touchActive = true;
          }, { passive: true });

          stage.addEventListener('touchmove', (e: TouchEvent) => {
            if (!touchActive) return;
            const dx = e.touches[0].clientX - touchStartX;
            const dy = e.touches[0].clientY - touchStartY;
            // If predominantly horizontal swipe, block vertical scroll propagation
            if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 8) {
              e.stopPropagation();
            }
          }, { passive: true });

          stage.addEventListener('touchend', (e: TouchEvent) => {
            if (!touchActive) return;
            touchActive = false;
            const dx = e.changedTouches[0].clientX - touchStartX;
            const dy = e.changedTouches[0].clientY - touchStartY;
            const SWIPE_THRESHOLD = 44;
            if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
              if (dx < 0 && current < slides.length - 1) {
                goTo(current + 1, 1);   // swipe left → next
              } else if (dx > 0 && current > 0) {
                goTo(current - 1, -1); // swipe right → prev
              }
            }
          }, { passive: true });
        }

        // Boot each carousel independently
        document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
      })();

    }
  </script>

</body>
