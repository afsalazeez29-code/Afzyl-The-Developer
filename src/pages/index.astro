}

.p3-project-num {
  font:
    600
    0.65rem/1
    var(--sans);

  color: rgba(241, 240, 235, 0.4);

  letter-spacing: 0.08em;
}

.p3-project-cat {
  font:
    500
    0.62rem/1
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.08em;

  color: rgba(241, 240, 235, 0.45);
}

.p3-project-name {
  margin: 0;

  font:
    700
    clamp(1rem, 1.6vw, 1.25rem)/1.1
    var(--heading);

  letter-spacing: -0.01em;

  color: #f1f0eb;
}

.p3-project-type {
  margin: 0;

  font:
    400
    0.75rem/1.3
    var(--sans);

  color: rgba(241, 240, 235, 0.55);
}

.p3-project-highlight {
  margin: 0;

  font:
    500
    0.67rem/1.3
    var(--sans);

  text-transform: uppercase;

  letter-spacing: 0.06em;

  color: rgba(241, 240, 235, 0.6);
}

.p3-project-desc {
  margin: 0;

  font:
    400
    0.78rem/1.55
    var(--sans);

  color: rgba(241, 240, 235, 0.72);
}

.p3-project-focus {
  margin: 0;

  font:
    400
    0.7rem/1.5
    var(--sans);

  color: rgba(241, 240, 235, 0.5);
}

.p3-project-quote {
  margin: 0.3rem 0 0;

  padding:
    0.4rem 0 0 0.7rem;

  border-left:
    2px solid
    rgba(241, 240, 235, 0.25);

  font:
    400
    italic
    0.78rem/1.5
    var(--sans);

  color: rgba(241, 240, 235, 0.65);
}

.p3-closing {
  margin:
    clamp(1.5rem, 3vw, 2.5rem)
    0
    0;

  font:
    700
    clamp(1rem, 2vw, 1.5rem)/1.1
    var(--heading);

  letter-spacing: 0.02em;

  text-transform: uppercase;

  color: #f1f0eb;
}


/* =========================================================
   PAGE 4 — CONTACT
   ========================================================= */

.p4-contact {
  position: absolute;

