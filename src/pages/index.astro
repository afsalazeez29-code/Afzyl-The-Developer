<style lang="scss">

/* =========================================================
   IMAGE SECTIONS
   ========================================================= */

.image-section {
  position: relative;

  width: 100%;

  aspect-ratio: 2560 / 1600;

  overflow: visible;

  background: #E9E7DF;

  /*
   * DO NOT use isolation here.
   * The particle layer must be able to sit
   * between the image and foreground elements.
   */

  isolation: auto;
}


/* =========================================================
   IMAGE BACKGROUND
   BOTTOM LAYER
   ========================================================= */

.hero-bg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: none;
  opacity: 1;

  z-index: 0;

  display: block;
}


/* =========================================================
   THREE.JS PARTICLE EFFECT
   ========================================================= */

.effect-layer {
  display: none !important;

  position: fixed;

  inset: 0;

  width: 100%;
  height: 100%;

  z-index: 10;

  pointer-events: none;
}

.effect-layer [data-container] {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;
}

.effect-layer canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;

  z-index: 0;
}


/* =========================================================
   PORTRAIT
   ========================================================= */

.portrait {
  position: absolute;

  z-index: 25;

  left: clamp(18rem, 6vw, 10rem);
  bottom: 0;

  height: auto;
  width: min(32vw, 42rem);

  max-width: none;
  max-height: none;

  object-fit: contain;
  object-position: left bottom;

  transform: none;

  pointer-events: none;
}


/* =========================================================
   HERO TEXT
   ========================================================= */

.hero h1 {
  position: absolute;

  z-index: 21;

  inset: 22% var(--gutter) auto;

  margin: 0;

  display: flex;

  flex-direction: column;

  font:
    500
    clamp(5rem, 13.5vw, 13rem)
    / 0.76
    var(--sans);

  letter-spacing: -0.085em;

  text-transform: uppercase;
}

.hero h1 span {
  display: block;

  overflow: hidden;
}

.hero h1 .outline {
  align-self: flex-end;

  color: transparent;

  -webkit-text-stroke:
    1.5px
    rgba(241, 240, 235, 0.78);
}


/* =========================================================
   HERO INDEX
   ========================================================= */

.hero-index {
  position: absolute;

  z-index: 21;

  top: 15%;

  left: var(--gutter);
}


/* =========================================================
   HERO ROLE
   ========================================================= */

