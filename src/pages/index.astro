  position: absolute;

  z-index: 21;

  right: var(--gutter);

  bottom: 5%;

  text-align: right;

  line-height: 1.8;
}


/* =========================================================
   HERO COPY
   ========================================================= */

.hero-copy {
  position: absolute;

  z-index: 21;

  left: var(--gutter);

  bottom: 5%;

  width: min(25rem, 42vw);

  display: flex;

  align-items: flex-end;

  gap: clamp(1.5rem, 4vw, 4rem);
}

.hero-copy > p {
  max-width: 17rem;

  margin: 0;

  font-size: clamp(0.8rem, 1vw, 0.95rem);

  line-height: 1.55;
}


/* =========================================================
   ROUND LINK
   ========================================================= */

.round-link {
  flex: 0 0 86px;

  aspect-ratio: 1;

  border:
    1px solid
    rgba(255, 255, 255, 0.45);

  border-radius: 50%;

  display: grid;

  place-content: center;

  gap: 0.4rem;

  text-align: center;

  font:
    0.58rem
    var(--mono);

  text-transform: uppercase;

  letter-spacing: 0.12em;

  transition:
    color 0.3s,
    background 0.3s,
    transform 0.3s;
}

.round-link:hover {
  color: var(--ink);

  background: #f1f0eb;

  transform: rotate(-8deg);
}

.round-link b {
  font:
    400
    1rem
    var(--sans);
}


/* =========================================================
   FOOTER — SINGLE-LINE SIGNATURE
   ========================================================= */

.compact-footer {
  position: absolute;

  left: var(--gutter);
  right: var(--gutter);

  bottom: clamp(0.8rem, 2vw, 1.5rem);

  z-index: 21;

  margin: 0;

  padding: clamp(0.7rem, 1.2vw, 1rem) 0 0;

  color: rgba(241, 240, 235, 0.65);

  background: transparent;

  font:
    400
    0.82rem/1.5
    var(--sans);

  letter-spacing: 0.02em;

  text-shadow:
    0 1px 12px
    rgba(0, 0, 0, 0.35);

  text-align: center;

  border-radius: 100px 100px 0 0;
}
.footer-curve {
  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 58px;

  pointer-events: none;
}

.compact-footer p {
  margin: 0;
}

.footer-name {
  color: #FAFAFA;

  text-decoration: underline;

  text-underline-offset: 3px;

  text-decoration-color: transparent;

  transition:
    text-decoration-color 0.18s ease,
    opacity 0.18s ease;

  cursor: pointer;
}

.footer-name:hover {
  text-decoration-color: rgba(241, 240, 235, 0.7);

  opacity: 1;
}

.footer-name {
  color: rgba(241, 240, 235, 0.9);

  text-decoration: underline;

  text-underline-offset: 3px;

  text-decoration-color: transparent;

  transition:
    text-decoration-color 0.18s ease,
    opacity 0.18s ease;

  cursor: pointer;
}

