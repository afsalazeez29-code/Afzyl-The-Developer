---
import SiteNav from '../components/SiteNav.svelte';
import CoreFullStack from '../components/Gap/CoreFullStack.svelte';
import Gap2CoreFullStack from '../components/Gap/Gap2CoreFullStack.svelte';
import Gap3CoreFullStack from '../components/Gap/Gap3CoreFullStack.svelte';
import '../styles/global.scss';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta
    name="description"
    content="Afzyl — creative developer crafting cinematic digital experiences."
  />
  <meta name="theme-color" content="#E9E7DF" />
  <title>Afzyl — Creative Developer</title>
</head>

<body>

  <!-- =====================================================
       THREE.JS PARTICLE EFFECT
       This stays BELOW portrait + icon waves.
       DO NOT MODIFY MainElement.js / Mouse.js.
       ===================================================== -->

  <div
    class="effect-layer"
    data-main-particles-component
    data-theme="dark"
    data-particles-scale="0.75"
    data-density="200"
    aria-hidden="true"
  >
    <div data-container></div>
  </div>

  <SiteNav client:load />

  <main id="top">

    <!-- ===================================================
         IMAGE 1 / HERO
         =================================================== -->

    <section class="image-section image-section-1">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG1.webp"
        alt=""
        fetchpriority="high"
      />

      <!-- PORTRAIT — TOP LAYER -->
      <img
        class="portrait"
        src="/Portraits/Portrait1.webp"
        alt="Portrait of Afzyl"
        fetchpriority="high"
      />

      <!-- GAP 1 ICON WAVE — TOP LAYER -->
      <div class="icon-wave-layer">
        <CoreFullStack client:load />
      </div>

    </section>


    <!-- ===================================================
         IMAGE 2
         =================================================== -->

    <section class="image-section image-section-2">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG2.webp"
        alt=""
        loading="eager"
      />

      <!-- GAP 2 ICON WAVE — TOP LAYER -->
      <div class="icon-wave-layer">
        <Gap2CoreFullStack client:load />
      </div>

    </section>


    <!-- ===================================================
         IMAGE 3
         =================================================== -->

    <section class="image-section image-section-3">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG3.webp"
        alt=""
        loading="lazy"
      />

      <!-- GAP 3 ICON WAVE — TOP LAYER -->
      <div class="icon-wave-layer">
        <Gap3CoreFullStack client:load />
      </div>

    </section>


    <!-- ===================================================
         IMAGE 4
         =================================================== -->

    <section class="image-section image-section-4 final-image-section">

      <!-- BACKGROUND — BOTTOM LAYER -->
      <img
        class="hero-bg"
        src="/images/Hero-BG4.webp"
        alt=""
        loading="lazy"
      />

      <footer class="compact-footer">

        <p>©️ 2026 AFZYL</p>

        <p>India</p>

        <div>
          <a href="#">LinkedIn</a>
          <a href="#">GitHub</a>
          <a href="#top">Back to top ↑</a>
        </div>

      </footer>

    </section>

  </main>


  <!-- =====================================================
       GSAP + LENIS + THREE.JS INITIALIZATION
       ===================================================== -->

  <script>
    import '../effects/MainElement.js';
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (!reduce) {

      const lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      if (document.querySelector('.hero h1 span')) {

        gsap.from('.hero h1 span', {
          yPercent: 120,
          opacity: 0,
          duration: 1.35,
          stagger: 0.12,
          ease: 'power4.out'
        });

      }

      if (document.querySelector('.portrait')) {

        gsap.from('.portrait', {
          yPercent: 8,
          opacity: 0,
          scale: 0.97,
          duration: 1.6,
          delay: 0.2,
          ease: 'power3.out'
        });

      }

    }
  </script>

</body>
</html>


<style lang="scss">

/* =========================================================
   EXACT GLOBAL LAYER ORDER
   =========================================================

   0 = IMAGE
   10 = PARTICLES
   20 = PORTRAIT
   30 = ICON WAVES

   Therefore:

   TOP
   ─────────────────────────
   Portrait + Icon Waves
   ─────────────────────────
   Three.js particles
   ─────────────────────────
   Background image
   ─────────────────────────
   BOTTOM
   ========================================================= */


/* =========================================================
   IMAGE SECTIONS
   ========================================================= */

.image-section {
  position: relative;

  width: 100%;

  aspect-ratio: 2560 / 1600;

  /*
   * IMPORTANT:
   * Allows icon waves to cross the image boundary.
   */
  overflow: visible;

  background: #E9E7DF;

  /*
   * DO NOT use isolation here.
   * The particle layer must be able to sit
   * between the image and foreground elements.
   */

  isolation: auto;
}


/* =========================================================
   IMAGE BACKGROUND
   BOTTOM LAYER
   ========================================================= */

.hero-bg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: none;
  opacity: 1;

  z-index: 0;

  display: block;
}


/* =========================================================
   THREE.JS PARTICLE EFFECT
   MIDDLE LAYER
   ========================================================= */

.effect-layer {
  position: fixed;

  inset: 0;

  width: 100%;
  height: 100%;

  /*
   * ABOVE IMAGE
   * BELOW PORTRAIT
   * BELOW ICON WAVES
   */

  z-index: 10;

  pointer-events: none;
}

.effect-layer [data-container] {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;
}

.effect-layer canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;

  /*
   * Keep the canvas itself in the particle layer.
   */

  z-index: 0;
}


/* =========================================================
   PORTRAIT
   TOP LAYER
   ========================================================= */

.portrait {
  position: absolute;
  z-index: 20;

  left: clamp(18rem, 6vw, 10rem);
  bottom: 0;

  height: auto;
  width: min(32vw, 42rem);

  max-width: none;
  max-height: none;

  object-fit: contain;
  object-position: left bottom;
  transform: none;

  pointer-events: none;
}

/* =========================================================
   ICON WAVES
   TOPMOST LAYER
   ========================================================= */

.icon-wave-layer {
  position: absolute;

  left: 0;
  right: 0;

  bottom: 0;

  width: 100%;

  height: clamp(180px, 18vw, 350px);

  /*
   * Exactly half inside the current image
   * and half into the next image.
   *
   * This places the wave on the boundary.
   */

  transform: translateY(50%);

  /*
   * ABOVE EVERYTHING
   */

  z-index: 30;

  pointer-events: none;
}


/* =========================================================
   HERO TEXT
   ========================================================= */

.hero h1 {
  position: absolute;

  z-index: 21;

  inset: 22% var(--gutter) auto;

  margin: 0;

  display: flex;

  flex-direction: column;

  font:
    500
    clamp(5rem, 13.5vw, 13rem)
    / 0.76
    var(--sans);

  letter-spacing: -0.085em;

  text-transform: uppercase;
}

.hero h1 span {
  display: block;

  overflow: hidden;
}

.hero h1 .outline {
  align-self: flex-end;

  color: transparent;

  -webkit-text-stroke:
    1.5px
    rgba(241, 240, 235, 0.78);
}


/* =========================================================
   HERO INDEX
   ========================================================= */

.hero-index {
  position: absolute;

  z-index: 21;

  top: 15%;

  left: var(--gutter);
}


/* =========================================================
   HERO ROLE
   ========================================================= */

.hero-role {
  position: absolute;

  z-index: 21;

  right: var(--gutter);

  bottom: 5%;

  text-align: right;

  line-height: 1.8;
}


/* =========================================================
   HERO COPY
   ========================================================= */

.hero-copy {
  position: absolute;

  z-index: 21;

  left: var(--gutter);

  bottom: 5%;

  width: min(25rem, 42vw);

  display: flex;

  align-items: flex-end;

  gap: clamp(1.5rem, 4vw, 4rem);
}

.hero-copy > p {
  max-width: 17rem;

  margin: 0;

  font-size: clamp(0.8rem, 1vw, 0.95rem);

  line-height: 1.55;
}


/* =========================================================
   ROUND LINK
   ========================================================= */

.round-link {
  flex: 0 0 86px;

  aspect-ratio: 1;

  border:
    1px solid
    rgba(255, 255, 255, 0.45);

  border-radius: 50%;

  display: grid;

  place-content: center;

  gap: 0.4rem;

  text-align: center;

  font:
    0.58rem
    var(--mono);

  text-transform: uppercase;

  letter-spacing: 0.12em;

  transition:
    color 0.3s,
    background 0.3s,
    transform 0.3s;
}

.round-link:hover {
  color: var(--ink);

  background: #f1f0eb;

  transform: rotate(-8deg);
}

.round-link b {
  font:
    400
    1rem
    var(--sans);
}


/* =========================================================
   FOOTER
   ========================================================= */

.compact-footer {
  position: absolute;

  left: var(--gutter);
  right: var(--gutter);

  bottom: clamp(0.8rem, 2vw, 1.5rem);

  z-index: 21;

  margin: 0;

  padding:
    clamp(0.7rem, 1.2vw, 1rem)
    0
    0;

  border-top:
    1px solid
    rgba(241, 240, 235, 0.42);

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  gap: 1rem;

  color: #f1f0eb;

  background: transparent;

  font:
    0.6rem
    var(--mono);

  text-transform: uppercase;

  letter-spacing: 0.08em;

  text-shadow:
    0 1px 18px
    rgba(0, 0, 0, 0.38);
}

.compact-footer p {
  margin: 0;
}

.compact-footer > p:nth-child(2) {
  text-align: center;
}

.compact-footer div {
  display: flex;

  justify-content: flex-end;

  gap: 1.5rem;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (min-width: 1920px) {

  .portrait {
    width: min(42vw, 48rem);
  }

}


@media (max-width: 1200px) {

  .portrait {
    width: min(42vw, 31rem);

    max-width: 45%;
  }

}


@media (max-width: 900px) {

  .portrait {
    width: min(46vw, 24rem);

    max-width: 48%;
  }

}


@media (max-width: 720px) {

  .hero h1 {
    top: 26%;

    font-size: 20vw;
  }

  .hero h1 .outline {
    align-self: flex-start;
  }

  .portrait {
    left: var(--gutter);

    width: min(50vw, 19rem);

    max-width: 54%;

    max-height:
      calc(100svh - 72px);
  }

  .hero-copy {
    width: 65%;
  }

  .round-link {
    display: none;
  }

  .hero-role {
    display: none;
  }

  .compact-footer {
    grid-template-columns:
      1fr
      auto;

    gap:
      0.7rem
      1rem;
  }

  .compact-footer > p:nth-child(2) {
    text-align: right;
  }

  .compact-footer div {
    grid-column: 1 / -1;

    justify-content: flex-start;

    gap: 1rem;
  }

}


@media (max-width: 480px) {

  .portrait {
    width: min(55vw, 15rem);

    max-width: 58%;
  }

}

</style>